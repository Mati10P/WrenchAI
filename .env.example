# Local development credentials only. Change before using real data.
POSTGRES_USER=wrenchai
POSTGRES_PASSWORD=wrenchai_local
POSTGRES_DB=wrenchai
# Used when running the API/migrations from the host shell.
DATABASE_URL=postgresql+psycopg://wrenchai:wrenchai_local@127.0.0.1:55432/wrenchai

# Gemini: server only. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional complete private library; enable only after exporting library-v1.
# Docker path; for host execution use the absolute local bundle directory.
MANUAL_LIBRARY_PATH=
