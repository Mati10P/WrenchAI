# Local development credentials only. Change before using real data.
POSTGRES_USER=wrenchai
POSTGRES_PASSWORD=wrenchai_local
POSTGRES_DB=wrenchai
# Used when running the API/migrations from the host shell.
DATABASE_URL=postgresql+psycopg://wrenchai:wrenchai_local@127.0.0.1:55432/wrenchai

# Gemini: server only. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
VISUAL_EVIDENCE_REVIEW=true
# Complementary public manufacturer documentation; may incur search charges.
WEB_SEARCH_ENABLED=true

# Optional complete private library; enable only after exporting library-v1.
# Docker path; for host execution use the absolute local bundle directory.
MANUAL_LIBRARY_PATH=
HYBRID_RETRIEVAL=false
MANUAL_FIGURES_PATH=
MANUAL_SECTIONS_PATH=
MANUAL_SECTIONS_DIRECTORY=./data/private/manuals/sections-v1
MANUAL_FIGURES_DIRECTORY=./data/private/manuals/figures-v1
# Enable only after a complete visual pass and matching vector rebuild.
MANUAL_NAVIGATION_PATH=
MANUAL_NAVIGATION_DIRECTORY=./data/private/manuals/navigation-v1
